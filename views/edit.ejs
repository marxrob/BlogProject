<%- include('partials/header.ejs')  -%>

    <style>
    .book-result img {
        width: 55px;
        height: 80px;
        object-fit: cover;
    }

    #selectedCover {
        width: 85px;
        height: 120px;
        object-fit: cover;
    }

    #reviewText {
        min-height: 180px;
    }
</style>

<main class="container py-5" style="max-width: 720px;">

    <h1 class="h3 mb-4">Add a new post!</h1>

    <form id="reviewForm" action="/new" method="POST">

        <!-- PESQUISA DO LIVRO -->
        <div class="mb-4">
            <label for="bookSearch" class="form-label fw-semibold">
                Search for a book
            </label>

            <input
                type="search"
                class="form-control"
                id="bookSearch"
                placeholder="Type the book title..."
                autocomplete="off"
            >

            <div id="searchStatus"
                 class="form-text"
                 role="status"
                 aria-live="polite">
                Type at least 2 characters to search.
            </div>

            <!-- Resultados da pesquisa -->
            <div id="searchResults" class="list-group mt-2"></div>
        </div>

        <!-- OLID PREENCHIDO AUTOMATICAMENTE -->
        <input type="hidden" id="olid" name="olid">

        <!-- LIVRO SELECIONADO -->
        <div id="selectedBook" class="card mb-4 d-none">
            <div class="card-body d-flex align-items-center gap-3">

                <img id="selectedCover" class="rounded"
                     alt="Selected book cover">

                <div>
                    <small class="text-body-secondary">
                        Selected book
                    </small>

                    <h5 id="selectedTitle" class="mb-1"></h5>

                    <p id="selectedAuthor" class="mb-1"></p>

                    <small id="selectedOlidDisplay"
                           class="text-body-secondary"></small>
                </div>

            </div>
        </div>

        <!-- TÍTULO DA REVIEW -->
        <div class="mb-4 col-md-7">
            <label for="reviewTitle" class="form-label fw-semibold">
                Review title
            </label>

            <input
                type="text"
                class="form-control"
                id="reviewTitle"
                name="title"
                placeholder="Enter your review title"
                maxlength="150"
                required
            >
        </div>

        <!-- TEXTO DA REVIEW -->
        <div class="mb-4">
            <label for="reviewText" class="form-label fw-semibold">
                Review text
            </label>

            <textarea
                class="form-control"
                id="reviewText"
                name="text"
                rows="7"
                placeholder="Write your thoughts about the book..."
                required
            ></textarea>
        </div>

        <!-- RATING -->
        <fieldset class="mb-4">
            <legend class="form-label fw-semibold fs-6">
                Your rating
            </legend>

            <div class="d-flex flex-wrap gap-3">

                <% for (let i = 1; i <= 5; i++) { %>
                    <div class="form-check">
                        <input
                            class="form-check-input"
                            type="radio"
                            name="rating"
                            id="rating<%= i %>"
                            value="<%= i %>"
                            required
                        >

                        <label class="form-check-label"
                               for="rating<%= i %>">
                            <%= i %> ★
                        </label>
                    </div>
                <% } %>

            </div>
        </fieldset>

        <!-- SUBMIT -->
        <button type="submit" class="btn btn-primary w-100 py-2">
            Publish Review
        </button>

    </form>
</main>


<script>
    const searchInput = document.getElementById("bookSearch");
    const searchResults = document.getElementById("searchResults");
    const searchStatus = document.getElementById("searchStatus");

    const selectedBook = document.getElementById("selectedBook");
    const selectedCover = document.getElementById("selectedCover");
    const selectedTitle = document.getElementById("selectedTitle");
    const selectedAuthor = document.getElementById("selectedAuthor");
    const selectedOlidDisplay = document.getElementById("selectedOlidDisplay");

    const olidInput = document.getElementById("olid");
    const reviewForm = document.getElementById("reviewForm");

    let searchTimer;
    let searchVersion = 0;

    // Detecta quando o usuário digita
    searchInput.addEventListener("input", () => {
        clearTimeout(searchTimer);
        const version = ++searchVersion;

        const query = searchInput.value.trim();

        // Limpa resultados e seleção anteriores
        searchResults.replaceChildren();
        selectedBook.classList.add("d-none");
        olidInput.value = "";

        if (query.length < 2) {
            searchStatus.textContent = "Type at least 2 characters.";
            return;
        }

        searchStatus.textContent = "Searching...";

        // Espera 350ms após o usuário parar de digitar
        searchTimer = setTimeout(async () => {
            try {
                const response = await fetch(
                    `/api/books/search?q=${encodeURIComponent(query)}`
                );

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const books = await response.json();

                // Ignora respostas de pesquisas antigas
                if (version !== searchVersion) return;

                console.log("Livros encontrados:", books);

                showBooks(books);

            } catch (error) {
                if (version !== searchVersion) return;

                console.error("Erro na pesquisa:", error);
                searchStatus.textContent = "Error searching books.";
            }
        }, 350);
    });

    // Cria os resultados clicáveis
    function showBooks(books) {
        searchResults.replaceChildren();

        if (books.length === 0) {
            searchStatus.textContent = "No books found.";
            return;
        }

        searchStatus.textContent = `${books.length} books found.`;

        books.forEach((book) => {
            const button = document.createElement("button");
            button.type = "button";
            button.className =
                "list-group-item list-group-item-action d-flex align-items-center gap-3 book-result";

            const image = document.createElement("img");
            image.src = book.cover;
            image.alt = `Cover of ${book.title}`;
            image.className = "rounded";
            image.onerror = () => image.classList.add("d-none");

            const info = document.createElement("div");

            const title = document.createElement("div");
            title.className = "fw-semibold";
            title.textContent = book.title;

            const author = document.createElement("small");
            author.className = "text-body-secondary";
            author.textContent = book.author;

            info.append(title, author);
            button.append(image, info);

            button.addEventListener("click", () => {
                selectBook(book);
            });

            searchResults.appendChild(button);
        });
    }

    // Preenche o livro selecionado e o OLID
    function selectBook(book) {
        clearTimeout(searchTimer);
        ++searchVersion;

        olidInput.value = book.olid;

        selectedTitle.textContent = book.title;
        selectedAuthor.textContent = book.author;
        selectedOlidDisplay.textContent = `OLID: ${book.olid}`;

        selectedCover.classList.remove("d-none");
        selectedCover.src = book.cover;
        selectedCover.onerror = () => {
            selectedCover.classList.add("d-none");
        };

        selectedBook.classList.remove("d-none");

        searchInput.value = book.title;
        searchResults.replaceChildren();
        searchStatus.textContent = "Book selected!";
    }

    // Bloqueia o envio sem livro selecionado
    reviewForm.addEventListener("submit", (event) => {
        if (!olidInput.value) {
            event.preventDefault();
            searchStatus.textContent = "Please select a book first.";
            searchInput.focus();
        }
    });
</script>


<%- include('partials/footer.ejs')  -%>